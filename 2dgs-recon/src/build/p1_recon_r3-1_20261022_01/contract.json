 "train_settings": {
  "res": 1512,
  "iters": 7000,
  "n_init": 150000,
  "seed": 0
 },
 "methods": {
  "M1": {
   "method": "SAM 2.1 (the leaflet-tuned v5 checkpoint, image predictor) propagated view-to-view along each ring ordered by azimuth: the previous view's whole-plant mask is lifted through the R3-base model's rendered depth into the next view and used as a box + positive-point prompt; union with A2 inside the projected 3D bounding box of the plant hull dilated by 1 cm",
   "seeds_per_ring": 3,
   "prompt_points": 6
  },
  "M2": {
   "method": "ridge candidates (sato, sigmas 3/6/10 px at 3024) inside the plant region dilated 90 px -> SAM point prompts for stems, petioles, petiolules; added region gated a* <= 2, L >= 15 and thin (26 px opening), touching the plant",
   "sigmas": [
    3,
    6,
    10
   ],
   "n_seed": 24,
   "thin_px": 26,
   "a_max": 2.0,
   "l_min": 15.0
  },
  "M3": {
   "method": "soil as its own class: the pot-top polygon (soil plane at the fitted rim height, side 62 mm around the plant centre) is projected per view; a per-capture soil colour model (Gaussian in Lab on pixels inside the polygon and outside every current plant mask) and a plant model (Gaussian on plant pixels) classify the pixels inside the polygon by likelihood ratio; plant wins when log-ratio >= 0",
   "rim_z_m": 0.066,
   "rim_side_m": 0.062,
   "min_soil_px": 2000
  },
  "M4": {
   "method": "alpha matte from a trimap: inside (mask eroded 2 px) = 1, outside (mask dilated 2 px) = 0, band = guided filter of the hard mask with the photo as guide (radius 4 px, eps 1e-3 at 1512), clipped to [0, 1]; the soft mask replaces the band exclusion in the alpha loss",
   "band_px": 2,
   "radius_px": 4,
   "eps": 0.001
  },
  "M5": {
   "method": "R3-base rendered into the TRAINING views only: pixels with rendered alpha >= 0.8 that the mask misses and that pass M3's plant test become SAM positive prompts (one round; never on held-out views)",
   "alpha_min": 0.8
  },
  "I1": {
   "method": "pycolmap SIFT 3024 px, 32,768 features, fixed board poses, foreground = Step 2 masks (as A3 of v2)"
  },
  "I2": {
   "method": "Depth Anything V2 Small (HF depth-anything/Depth-Anything-V2-Small-hf) per training view; per-view affine (scale, shift) fit of 1/depth to the I1 points visible in that view by RANSAC-trimmed least squares; back-projected points added only where I1 has < N points, inside the Step 2 mask, tagged mono_prior",
   "n_min": 300,
   "rel_residual_max": 0.08
  },
  "T": {
   "method": "per-image affine colour compensation (3x3 + offset, learnt), soft-mask alpha loss (M4), depth-normal consistency 0.05, depth loss (L1 on rendered median depth vs I1 points 0.05, vs I2 points 0.01), densification: R3 values and one declared alternative (grow_grad2d 1.5e-4, refine until 6000); iterations 7000; resolution 1512; 3024 only as R3-1d"
  }
 },
